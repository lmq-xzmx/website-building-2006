{
  "name": "@geokit/geo-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GEO 核心库：JSON-LD 生成 / llms.txt / robots+AI 爬虫策略 / GEO 体检评分 / 内容索引",
  "main": "./dist/index.js",
