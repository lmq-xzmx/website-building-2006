{
  "name": "@geokit/site-corporate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用企业站骨架（7 页型）—— GEO-ready 模板",
  "scripts": {
    "dev": "next dev -p 5101",
    "build": "next build",
    "start": "next start -p 5101",
    "export": "next build && node scripts/export-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "geo:generate": "node ../../packages/geo-kit/dist/cli.js generate content/site.ts --out public --full",
    "geo:audit": "node ../../packages/geo-kit/dist/cli.js audit http://localhost:5101 --content content/site.ts"
  },
  "dependencies": {
    "@geokit/geo-kit": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
