  {
    "type": "FAQPage",
    "data": {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "url": "https://www.example-tech.com/faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "最小起订量是多少？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "标准产品线最小起订量为 10 台，单台即可购买样机。定制开发项目最小起订量为 50 台。"
          }
        },
        {
          "@type": "Question",
          "name": "从下单到交付需要多长时间？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "标准型号备货充足，下单后 3 个工作日内发货。定制型号交期为 25 至 40 个工作日，取决于硬件改版与认证进度。"
          }
        },
        {
          "@type": "Question",
          "name": "支持哪些工业协议？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "标准固件支持 Modbus RTU/TCP、OPC UA、Profinet、Modbus RTU over Serial 四类协议。第三方协议可通过 SDK 扩展，通常需要 5 个工作日。"
          }
        },
        {
          "@type": "Question",
          "name": "能否对接客户已有的 MES 或 ERP 系统？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "可以。DM 管理平台提供 RESTful API 与 Kafka 消息队列两种对接方式，已预置 SAP、Oracle、用友、金蝶四套标准连接器。"
          }
        },
        {
          "@type": "Question",
          "name": "设备的质保期与售后响应是什么？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "标准型号质保 3 年，定制型号质保 2 年。华东地区承诺 4 小时到场，远程支持在 30 分钟内响应。"
          }
        },
        {
          "@type": "Question",
          "name": "是否支持私有化部署？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "支持。DM 管理平台提供私有化部署包，支持单机与三节点高可用两种拓扑，授权按节点数计费。"
          }
        }
      ]
    },
    "target": "body"
  },
