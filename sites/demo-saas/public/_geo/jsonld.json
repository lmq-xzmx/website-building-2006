  {
    "type": "FAQPage",
    "data": {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "url": "https://www.yunshu-tech.com/faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "私有化部署需要多少台服务器？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "最小配置为 3 台（2 台应用 + 1 台数据库），推荐生产环境 5 台起。单机部署仅适用于测试环境，官方不提供单机版的 SLA 承诺。"
          }
        },
        {
          "@type": "Question",
          "name": "SLA 可用性是多少？未达标如何赔付？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "标准版承诺 99.9% 月度可用性，企业版 99.95%，旗舰版 99.99%。未达标按月度服务费比例赔付，单月最高赔付 30%。"
          }
        },
        {
          "@type": "Question",
          "name": "是否支持信创环境？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "已完成 12 家主流信创产品的兼容性认证，涵盖麒麟与统信操作系统、达梦与人大金仓数据库、飞腾与鲲鹏处理器。"
          }
        },
        {
          "@type": "Question",
          "name": "私有化部署如何授权？是否需要联网？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "使用离线许可证，部署完成后无需连接外网即可正常运行。许可证默认 3 年期，可按年续期。"
          }
        },
        {
          "@type": "Question",
          "name": "审计日志保留多久？能对接内部审计系统吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "默认保留 3 年，可延长至 7 年。支持通过 syslog 与 Kafka 两种方式对接客户内部审计系统。"
          }
        },
        {
          "@type": "Question",
          "name": "数据隔离到什么粒度？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "租户间数据库物理隔离，租户内按项目行级隔离。所有跨租户查询在数据库层被拒绝，不依赖应用层过滤。"
          }
        },
        {
          "@type": "Question",
          "name": "实施周期一般多久？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "标准产品线最快 4 周上线。涉及多系统集成的复杂项目通常 8 至 12 周，其中需求确认与数据迁移占约 60% 工时。"
          }
        }
      ]
    },
    "target": "body"
  },
